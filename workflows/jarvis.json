    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Telegram voice notes arrive as .oga; transcription APIs accept the same Ogg/Opus data as .ogg\nconst data = $input.item.binary.data;\nconst isOga = data.fileExtension === 'oga' || /\\.oga$/i.test(data.fileName || '');\nconst fixed = isOga ? { ...data, fileName: 'voice.ogg', fileExtension: 'ogg', mimeType: 'audio/ogg' } : data;\nreturn { json: $json, binary: { data: fixed } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        32
      ],
