    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Turns any Telegram message into a text prompt for the agent.\n// A photo keeps its binary so the agent sees the image; audio is dropped after transcription.\nconst m = $('Telegram Trigger').item.json.message;\nlet prompt;\nif (m.text) {\n  prompt = m.text;\n} else if (m.photo) {\n  prompt = m.caption || '[The user sent a photo without a caption. Look at it and respond.]';\n} else if (m.voice || m.audio) {\n  const transcript = String($json.text || '').trim();\n  prompt = transcript\n    ? '[Voice message, transcribed] ' + transcript\n    : '[The user sent a voice message that could not be transcribed. Ask them to send it as text.]';\n} else {\n  const skip = ['message_id', 'from', 'chat', 'date', 'caption', 'entities', 'caption_entities'];\n  const kind = m.sticker\n    ? ('sticker ' + (m.sticker.emoji || '')).trim()\n    : Object.keys(m).filter((k) => !skip.includes(k)).join(', ') || 'unknown';\n  prompt = '[The user sent something you cannot read yet (' + kind + '). '\n    + 'Reply briefly that for now you understand text, photos and voice messages.]';\n}\nconst item = { json: { prompt } };\nif (m.photo) item.binary = $input.item.binary;\nreturn item;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1504,
        -48
      ],
      "id": "6535ab49-36fe-4222-bf91-728af127ded6",
      "name": "Build prompt"
    }
