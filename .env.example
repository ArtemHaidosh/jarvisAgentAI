# Settings template. Do NOT put real values here.
# Run scripts\setup.ps1: it creates .env (ignored by git) and asks for the secrets.

# Bot token from @BotFather, format 123456789:AA...
# Used by the status script and tests; in n8n it is entered separately as a credential.
TELEGRAM_BOT_TOKEN=

# Authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Your free static domain from https://dashboard.ngrok.com/domains
# No https:// and no trailing slash, e.g.: my-name.ngrok-free.app
NGROK_DOMAIN=

# Encryption key for credentials stored in n8n. setup.ps1 generates it.
# Do not change it after the first start, or n8n can't read saved credentials.
N8N_ENCRYPTION_KEY=

# Optional
TIMEZONE=Europe/Kyiv
N8N_VERSION=stable
NGROK_VERSION=latest
